# Variáveis usadas pelos testes automatizados (npm test). Não há segredos aqui.
# O banco PRECISA terminar em _test: o setup dos testes apaga todos os dados dele
# e se recusa a rodar em qualquer outro banco.
# Local: docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db
DATABASE_URL="mysql://root:rootpassword@127.0.0.1:3306/fredda_test"
NEXTAUTH_SECRET="segredo-dos-testes"
NEXTAUTH_URL="http://localhost:3000"
METRICS_TOKEN="token-dos-testes"
IA_URL="http://ia.teste"
IA_API_KEY="chave-ia-dos-testes"
WHATSAPP_PROVEDOR="meta"
WHATSAPP_TOKEN="token-whatsapp-dos-testes"
WHATSAPP_PHONE_NUMBER_ID="123456"
WHATSAPP_VERIFY_TOKEN="verificacao-dos-testes"
WHATSAPP_APP_SECRET="segredo-app-dos-testes"
TWILIO_ACCOUNT_SID="ACteste"
TWILIO_AUTH_TOKEN="token-twilio-dos-testes"
ANTHROPIC_API_KEY=""

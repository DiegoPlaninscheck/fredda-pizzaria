# =============================================================================
# Banco de dados
# =============================================================================
DATABASE_URL="mysql://fredda:fredda123@localhost:3306/fredda_pizzaria"

# Credenciais MySQL (usadas no docker-compose)
MYSQL_ROOT_PASSWORD="rootpassword"
MYSQL_DATABASE="fredda_pizzaria"
MYSQL_USER="fredda"
MYSQL_PASSWORD="fredda123"

# =============================================================================
# NextAuth.js
# =============================================================================
# URL base da aplicação (sem barra no final)
NEXTAUTH_URL="http://localhost:3000"

# Chave secreta — gere com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-uma-chave-gerada"

# =============================================================================
# Chatbot de pedidos (Claude + WhatsApp Cloud API)
# =============================================================================
# Chave da API da Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Meta for Developers → seu app → WhatsApp → Configuração da API
WHATSAPP_TOKEN=""              # token de acesso (permanente, de usuário do sistema)
WHATSAPP_PHONE_NUMBER_ID=""    # "Identificação do número de telefone"
WHATSAPP_VERIFY_TOKEN=""       # texto livre; o mesmo informado ao cadastrar o webhook
WHATSAPP_APP_SECRET=""         # Configurações do app → Básico → Chave secreta do app

# Domínio público da VPS (usado pelo Caddy para emitir o certificado HTTPS)
DOMINIO="pedidos.seudominio.com.br"

# =============================================================================
# Previsão de demanda (microsserviço ia/)
# =============================================================================
# Chave exigida no cabeçalho X-API-Key — gere com: openssl rand -hex 32
IA_API_KEY=""
# URL do serviço (no docker-compose já é http://ia:8000; em dev local, rode o uvicorn na 8000)
IA_URL="http://localhost:8000"

# =============================================================================
# Ambiente
# =============================================================================
NODE_ENV="development"
